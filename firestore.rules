rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /team_members/{memberId} {
      allow read, write: if true;
    }
    match /app_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
